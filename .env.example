# =============================================================================
#  MODÈLE DE CONFIGURATION
#  Copie ce fichier en ".env" (start.bat le fait pour toi) puis remplis-le.
#  Le fichier .env contient des secrets : ne le partage JAMAIS.
# =============================================================================

# Clé de licence serveur, à créer sur https://portal.cfx.re
LICENSE_KEY=change_moi

# Nom affiché dans la liste des serveurs FiveM
SERVER_NAME=Gunfight FR | Attaque de zone & Redzone

# Nombre de joueurs max. La clé gratuite est plafonnée à 48 : au-delà, FiveM
# refuse les connexions (erreur "more slots than allowed by the current
# subscription"). Il faut un abonnement Element Club Cfx.re
# (https://portal.cfx.re/subscriptions) pour monter plus haut.
MAX_PLAYERS=48

# Optionnel : plafonds mémoire des conteneurs Docker. Valeurs par défaut si les
# lignes restent commentées : 4g pour FXServer, 2g pour MariaDB. À augmenter
# seulement si la machine a de la marge (voir docs/architecture.md).
# FXSERVER_MEMORY_LIMIT=4g
# MARIADB_MEMORY_LIMIT=2g

# Administrateurs (séparés par des virgules). Ton identifiant s'affiche dans
# la console du serveur quand tu te connectes, exemple : fivem:1234567
ADMIN_IDENTIFIERS=

# Panneau txAdmin : http://127.0.0.1:40120 (code PIN affiché dans les logs).
# txAdmin est le lanceur du serveur : il démarre avec lui et pilote le serveur
# de jeu. Laisse TXADMIN=true (ou supprime la ligne). Mets false pour démarrer
# FXServer directement sur server.cfg, sans panneau web (test rapide, CI).
# Tests locaux : TXADMIN=false et MAX_PLAYERS=48, fixés dans le shell avant
# chaque lancement (voir docs/debug-test.md, section 2 « Prérequis »).
TXADMIN=true

# Optionnel : clé API Steam (https://steamcommunity.com/dev/apikey)
STEAM_WEB_API_KEY=

# Base de données (utilisée plus tard pour les statistiques)
# Mets des mots de passe longs et différents !
# Évite les caractères @ : / ? # dans les mots de passe : ils cassent la
# chaîne de connexion mysql:// générée pour oxmysql (phase 2).
MARIADB_DATABASE=gunfight
MARIADB_USER=gunfight
MARIADB_PASSWORD=change_moi_aussi
MARIADB_ROOT_PASSWORD=change_moi_root

# =============================================================================
#  PRODUCTION UNIQUEMENT
#  En local, laisse ce bloc commenté : la surcouche dev construit l'image.
#  Sur le VPS, renseigne l'image publiée par la CI, par exemple :
#  IMAGE_REF=ghcr.io/compte/fivemgunfight:v1.2.3
#  Remplace "compte" par le propriétaire du dépôt et "v1.2.3" par un tag
#  publié. Un tag de version (plutôt que latest) permet de revenir en arrière
#  en remettant l'ancienne valeur. Cette variable n'est lue que par la
#  surcouche docker-compose.prod.yml ; inutile en développement.
# =============================================================================
# IMAGE_REF=ghcr.io/compte/fivemgunfight:v1.2.3
