# =============================================================================
#  MODÈLE DE CONFIGURATION
#  Copie ce fichier en ".env" (start.bat le fait pour toi) puis remplis-le.
#  Le fichier .env contient des secrets : ne le partage JAMAIS.
# =============================================================================

# Clé de licence serveur, à créer sur https://portal.cfx.re
LICENSE_KEY=change_moi

# Nom affiché dans la liste des serveurs FiveM
SERVER_NAME=Gunfight FR | Attaque de zone & Redzone

# Nombre de joueurs max. La clé gratuite est plafonnée à 48 : au-delà, il faut
# un abonnement Element Club Cfx.re (https://portal.cfx.re/subscriptions).
# Si la clé ne couvre pas 300, FiveM plafonne automatiquement : baisse la valeur.
MAX_PLAYERS=300

# Administrateurs (séparés par des virgules). Ton identifiant s'affiche dans
# la console du serveur quand tu te connectes, exemple : fivem:1234567
ADMIN_IDENTIFIERS=

# Panneau txAdmin : http://127.0.0.1:40120 (code PIN affiché dans les logs).
# txAdmin est le lanceur du serveur : il démarre avec lui et pilote le serveur
# de jeu. Laisse TXADMIN=true (ou supprime la ligne). Mets false pour démarrer
# FXServer directement sur server.cfg, sans panneau web (test rapide, CI).
TXADMIN=true

# Optionnel : clé API Steam (https://steamcommunity.com/dev/apikey)
STEAM_WEB_API_KEY=

# Base de données (utilisée plus tard pour les statistiques)
# Mets des mots de passe longs et différents !
# Évite les caractères @ : / ? # dans les mots de passe : ils cassent la
# chaîne de connexion mysql:// générée pour oxmysql (phase 2).
MARIADB_DATABASE=gunfight
MARIADB_USER=gunfight
MARIADB_PASSWORD=change_moi_aussi
MARIADB_ROOT_PASSWORD=change_moi_root
